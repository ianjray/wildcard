.POSIX:
.SUFFIXES:
.SUFFIXES: .c .o .uto

VERSION    = 1.0.0

CC         = @CC@
CCOV       = gcov
CFLAGS     = @CFLAGS@
CFLAGS_COV = @CFLAGS_COV@
CFLAGS_SAN = @CFLAGS_SAN@
INCLUDEDIR = @PREFIX@/include
LD         = @LD@
LIBDIR     = @PREFIX@/lib
PREFIX     = @PREFIX@

.PHONY: all
all: libwild.a

libwild.a: wildcard.o
	$(LD) -r $< -o $@

.c.o:
	$(CC) $(CFLAGS) -I. -c $< -o $@

.c.uto:
	$(CC) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. -c $< -o $@

wildcard.coverage: wildcard.uto tests/test_wildcard.c
	$(CC) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. $^ -o $@
	./$@
	$(CCOV) wildcard.c
	! grep "#####" wildcard.c.gcov |grep -ve "// UNREACHABLE$$"

libwild.pc:
	( echo 'Name: libwild' ;\
	echo 'Version: $(VERSION)' ;\
	echo 'Description: Wildcard matching in C' ;\
	echo 'prefix=$(PREFIX)' ;\
	echo 'exec_prefix=$${prefix}' ;\
	echo 'includedir=$${prefix}/include' ;\
	echo 'libdir=$${prefix}/lib' ;\
	echo 'Cflags: -I$${includedir}' ;\
	echo 'Libs: -L$${libdir} -lwild' ) > $@

.PHONY: test
test: wildcard.coverage

.PHONY: install
install: wildcard.h libwild.a libwild.pc
	mkdir -p $(DESTDIR)$(INCLUDEDIR)/libwild
	mkdir -p $(DESTDIR)$(LIBDIR)/pkgconfig
	install -m644 wildcard.h $(DESTDIR)$(INCLUDEDIR)/libwild/wildcard.h
	install -m644 libwild.a $(DESTDIR)$(LIBDIR)/libwild.a
	install -m644 libwild.pc $(DESTDIR)$(LIBDIR)/pkgconfig/libwild.pc

.PHONY: uninstall
uninstall:
	rm -f $(DESTDIR)$(INCLUDEDIR)/libwild/wildcard.h
	rm -f $(DESTDIR)$(LIBDIR)/libwild.a
	rm -f $(DESTDIR)$(LIBDIR)/pkgconfig/libwild.pc

.PHONY: clean
clean:
	rm -f *.o **/*.o *.uto **/*.uto *.gc?? **/*.gc?? *.coverage
	rm -f libwild.a libwild.pc

.PHONY: distclean
distclean: clean
	rm -f Makefile config.status
